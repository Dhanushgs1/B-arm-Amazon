[{"file": "package.json", "data": "{\n  \"name\": \"amazon-ppc-analytics\",\n  \"type\": \"module\"\n}\n"}, {"file": "vercel.json", "data": "{\n  \"rewrites\": [\n    { \"source\": \"/sm/:path*\", \"destination\": \"/api/sm?path=:path*\" }\n  ]\n}\n"}, {"file": "api/sm.js", "data": "// Vercel serverless proxy \u2192 SellerMate Public API\n// Avoids browser CORS issues. The API key is passed per-request from the\n// client's x-api-key header and never stored server-side.\nconst BASE = \"https://api.sellermate.ai/public/v1\";\n\nexport default async function handler(req, res) {\n  res.setHeader(\"Access-Control-Allow-Origin\", \"*\");\n  res.setHeader(\"Access-Control-Allow-Headers\", \"Content-Type, X-API-Key\");\n  res.setHeader(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\");\n  if (req.method === \"OPTIONS\") return res.status(204).end();\n\n  const key = req.headers[\"x-api-key\"];\n  if (!key) return res.status(401).json({ message: \"Missing X-API-Key\" });\n\n  const path = req.query.path; // e.g. \"tools\" or \"tools/get_user_context\"\n  if (!path || !/^tools(\\/[a-z0-9_]+)?$/.test(path)) {\n    return res.status(400).json({ message: \"Invalid path\" });\n  }\n\n  try {\n    const upstream = await fetch(`${BASE}/${path}`, {\n      method: req.method,\n      headers: { \"X-API-Key\": key, \"Content-Type\": \"application/json\" },\n      body: req.method === \"POST\" ? JSON.stringify(req.body || {}) : undefined,\n    });\n    const retryAfter = upstream.headers.get(\"retry-after\");\n    if (retryAfter) res.setHeader(\"Retry-After\", retryAfter);\n    const text = await upstream.text();\n    res.status(upstream.status);\n    res.setHeader(\"Content-Type\", \"application/json\");\n    return res.send(text);\n  } catch (e) {\n    return res.status(502).json({ message: \"Upstream error: \" + e.message });\n  }\n}\n"}, {"file": "index.html", "data": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Amazon PPC Analytics \u2014 SellerMate</title>\n<style>\n:root{\n  --surface-1:#fcfcfb; --page:#f9f9f7;\n  --ink:#0b0b0b; --ink-2:#52514e; --muted:#898781;\n  --grid:#e1e0d9; --baseline:#c3c2b7; --border:rgba(11,11,11,0.10);\n  --s1:#2a78d6; --s2:#1baf7a; --s3:#eda100; --s6:#e34948;\n  --good:#006300; --bad:#d03b3b;\n}\n@media (prefers-color-scheme: dark){\n  :root{\n    --surface-1:#1a1a19; --page:#0d0d0d;\n    --ink:#ffffff; --ink-2:#c3c2b7; --muted:#898781;\n    --grid:#2c2c2a; --baseline:#383835; --border:rgba(255,255,255,0.10);\n    --s1:#3987e5; --s2:#199e70; --s3:#c98500; --s6:#e66767;\n    --good:#0ca30c; --bad:#e66767;\n  }\n}\n*{box-sizing:border-box;margin:0;padding:0}\nbody{font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;background:var(--page);color:var(--ink);font-size:14px}\n.wrap{max-width:1200px;margin:0 auto;padding:20px}\nh1{font-size:20px;font-weight:700}\nh2{font-size:15px;font-weight:600;margin-bottom:12px}\n.card{background:var(--surface-1);border:1px solid var(--border);border-radius:10px;padding:16px;margin-bottom:16px}\n.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}\ninput,select,button{font:inherit;color:var(--ink);background:var(--surface-1);border:1px solid var(--baseline);border-radius:8px;padding:8px 12px}\nbutton{cursor:pointer}\nbutton.primary{background:var(--s1);color:#fff;border-color:var(--s1)}\nbutton.chip{padding:6px 12px;border-radius:16px;font-size:13px}\nbutton.chip.on{background:var(--s1);color:#fff;border-color:var(--s1)}\n.tabs{display:flex;gap:4px;margin:16px 0;border-bottom:1px solid var(--grid);flex-wrap:wrap}\n.tabs button{border:none;background:none;padding:10px 14px;color:var(--ink-2);border-bottom:2px solid transparent;border-radius:0}\n.tabs button.on{color:var(--ink);border-bottom-color:var(--s1);font-weight:600}\n.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:16px}\n.tile{background:var(--surface-1);border:1px solid var(--border);border-radius:10px;padding:14px}\n.tile .lbl{font-size:12px;color:var(--muted);margin-bottom:4px}\n.tile .val{font-size:22px;font-weight:700}\ntable{width:100%;border-collapse:collapse}\nth{text-align:left;font-size:12px;color:var(--muted);font-weight:600;padding:8px;border-bottom:1px solid var(--grid);cursor:pointer;white-space:nowrap}\ntd{padding:8px;border-bottom:1px solid var(--grid);font-variant-numeric:tabular-nums}\ntd.num,th.num{text-align:right}\n.scroll{overflow-x:auto}\n.muted{color:var(--muted);font-size:13px}\n.err{color:var(--bad);font-size:13px;margin-top:8px}\n.spin{display:inline-block;width:16px;height:16px;border:2px solid var(--grid);border-top-color:var(--s1);border-radius:50%;animation:sp .8s linear infinite;vertical-align:middle}\n@keyframes sp{to{transform:rotate(360deg)}}\n.legend{display:flex;gap:16px;font-size:12px;color:var(--ink-2);margin-bottom:8px}\n.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px}\n.pgn{display:flex;gap:8px;align-items:center;margin-top:10px;font-size:13px;color:var(--ink-2)}\n.hidden{display:none}\n#tooltip{position:fixed;pointer-events:none;background:var(--surface-1);border:1px solid var(--border);border-radius:8px;padding:8px 10px;font-size:12px;box-shadow:0 4px 12px rgba(0,0,0,.15);z-index:10;display:none}\n.hdr{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:8px}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <div class=\"hdr\">\n    <h1>Amazon PPC Analytics</h1>\n    <div class=\"row\" id=\"topbar\" style=\"display:none\">\n      <select id=\"accountSel\"></select>\n      <button class=\"chip\" onclick=\"logout()\">Change API key</button>\n    </div>\n  </div>\n\n  <!-- KEY SETUP -->\n  <div class=\"card\" id=\"setup\">\n    <h2>Connect SellerMate</h2>\n    <p class=\"muted\" style=\"margin-bottom:10px\">Paste your SellerMate API key (starts with <code>sm_live_</code>). It is stored only in this browser's localStorage and sent directly to the SellerMate API on each request.</p>\n    <div class=\"row\">\n      <input type=\"password\" id=\"keyInput\" placeholder=\"sm_live_...\" style=\"flex:1;min-width:260px\">\n      <button class=\"primary\" onclick=\"connect()\">Connect</button>\n    </div>\n    <div class=\"err\" id=\"setupErr\"></div>\n  </div>\n\n  <!-- APP -->\n  <div id=\"app\" class=\"hidden\">\n    <div class=\"card\">\n      <div class=\"row\">\n        <span class=\"muted\">Date range:</span>\n        <span id=\"presets\"></span>\n        <input type=\"date\" id=\"d1\"> <span class=\"muted\">to</span> <input type=\"date\" id=\"d2\">\n        <button class=\"primary\" onclick=\"refresh()\">Apply</button>\n        <span id=\"loading\" class=\"hidden\"><span class=\"spin\"></span></span>\n      </div>\n      <div class=\"err\" id=\"appErr\"></div>\n    </div>\n\n    <div class=\"tabs\" id=\"tabs\"></div>\n\n    <div id=\"view-overview\">\n      <div class=\"tiles\" id=\"ovTiles\"></div>\n      <div class=\"card\"><h2>Top 10 campaigns \u2014 Spend vs Sales</h2>\n        <div class=\"legend\"><span><i style=\"background:var(--s1)\"></i>Spend</span><span><i style=\"background:var(--s2)\"></i>Sales</span></div>\n        <div id=\"ovChart\"></div>\n      </div>\n    </div>\n\n    <div id=\"view-campaigns\" class=\"hidden\"><div class=\"card\">\n      <div class=\"hdr\"><h2>Campaign performance</h2>\n        <select id=\"cmpStatus\" onchange=\"loadCampaigns(0)\">\n          <option value=\"ENABLED\">Enabled</option><option value=\"PAUSED\">Paused</option><option value=\"ARCHIVED\">Archived</option>\n        </select></div>\n      <div class=\"scroll\"><table id=\"cmpTbl\"></table></div>\n      <div class=\"pgn\" id=\"cmpPgn\"></div>\n    </div></div>\n\n    <div id=\"view-searchterms\" class=\"hidden\"><div class=\"card\">\n      <div class=\"hdr\"><h2>Search terms</h2>\n        <input id=\"stSearch\" placeholder=\"Filter search term\u2026\" onchange=\"loadTerms(0)\"></div>\n      <div class=\"scroll\"><table id=\"stTbl\"></table></div>\n      <div class=\"pgn\" id=\"stPgn\"></div>\n    </div></div>\n\n    <div id=\"view-targeting\" class=\"hidden\"><div class=\"card\">\n      <h2>Targeting performance</h2>\n      <div class=\"scroll\"><table id=\"tgTbl\"></table></div>\n      <div class=\"pgn\" id=\"tgPgn\"></div>\n    </div></div>\n\n    <div id=\"view-products\" class=\"hidden\"><div class=\"card\">\n      <h2>Advertised products</h2>\n      <div class=\"scroll\"><table id=\"pdTbl\"></table></div>\n      <div class=\"pgn\" id=\"pdPgn\"></div>\n    </div></div>\n\n    <div id=\"view-placements\" class=\"hidden\"><div class=\"card\">\n      <h2>Placement performance</h2>\n      <div class=\"scroll\"><table id=\"plTbl\"></table></div>\n      <div class=\"pgn\" id=\"plPgn\"></div>\n    </div></div>\n  </div>\n</div>\n<div id=\"tooltip\"></div>\n\n<script>\nconst $ = id => document.getElementById(id);\nlet KEY = localStorage.getItem('sm_key') || '';\nlet ACCOUNTS = [], ACCT = null, CUR = 'USD';\n\nasync function api(tool, args = {}) {\n  const r = await fetch('/sm/tools/' + tool, {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json', 'X-API-Key': KEY },\n    body: JSON.stringify(args)\n  });\n  const j = await r.json().catch(() => ({}));\n  if (!r.ok) throw new Error(j.message || j.error || ('HTTP ' + r.status));\n  if (j.error) throw new Error(j.error);\n  return j;\n}\n\nconst fmtM = n => n == null ? '\u2014' : new Intl.NumberFormat(undefined,{style:'currency',currency:CUR,maximumFractionDigits:0}).format(n);\nconst fmtM2 = n => n == null ? '\u2014' : new Intl.NumberFormat(undefined,{style:'currency',currency:CUR,maximumFractionDigits:2}).format(n);\nconst fmtN = n => n == null ? '\u2014' : new Intl.NumberFormat().format(Math.round(n));\nconst fmtP = n => n == null ? '\u2014' : (+n).toFixed(1) + '%';\nconst esc = s => String(s ?? '').replace(/[&<>\"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\n\n// ---------- setup ----------\nasync function connect() {\n  const k = $('keyInput').value.trim();\n  if (!k) return;\n  KEY = k; $('setupErr').textContent = '';\n  try {\n    const ctx = await api('get_user_context');\n    ACCOUNTS = (ctx.workspaces || []).flatMap(w => w.accounts || []);\n    if (!ACCOUNTS.length) throw new Error('No accessible Amazon accounts for this key.');\n    localStorage.setItem('sm_key', KEY);\n    initApp();\n  } catch (e) { $('setupErr').textContent = e.message; }\n}\nfunction logout() {\n  localStorage.removeItem('sm_key'); KEY = '';\n  $('app').classList.add('hidden'); $('setup').classList.remove('hidden');\n  $('topbar').style.display = 'none';\n}\n\nfunction initApp() {\n  $('setup').classList.add('hidden'); $('app').classList.remove('hidden');\n  $('topbar').style.display = 'flex';\n  $('accountSel').innerHTML = ACCOUNTS.map((a,i) =>\n    `<option value=\"${i}\">${esc(a.name)} (${esc(a.country)} \u00b7 ${esc(a.accountType)})</option>`).join('');\n  $('accountSel').onchange = () => { setAcct(+$('accountSel').value); refresh(); };\n  setAcct(0);\n  setPreset(30);\n  refresh();\n}\nfunction setAcct(i){ ACCT = ACCOUNTS[i]; CUR = ACCT.currency || 'USD'; }\n\n// dates\nconst iso = d => d.toISOString().slice(0,10);\nfunction setPreset(days){\n  const end = new Date(); end.setDate(end.getDate()-1);\n  const start = new Date(end); start.setDate(start.getDate()-days+1);\n  $('d1').value = iso(start); $('d2').value = iso(end);\n  document.querySelectorAll('#presets .chip').forEach(b => b.classList.toggle('on', +b.dataset.d === days));\n}\n$('presets').innerHTML = [7,14,30,90].map(d =>\n  `<button class=\"chip\" data-d=\"${d}\" onclick=\"setPreset(${d});refresh()\">Last ${d}d</button>`).join(' ');\n\n// tabs\nconst TABS = [['overview','Overview'],['campaigns','Campaigns'],['searchterms','Search Terms'],['targeting','Targeting'],['products','Products'],['placements','Placements']];\nlet TAB = 'overview';\n$('tabs').innerHTML = TABS.map(([k,l]) => `<button data-t=\"${k}\" onclick=\"showTab('${k}')\">${l}</button>`).join('');\nfunction showTab(k){\n  TAB = k;\n  document.querySelectorAll('#tabs button').forEach(b => b.classList.toggle('on', b.dataset.t === k));\n  TABS.forEach(([t]) => $('view-'+t).classList.toggle('hidden', t !== k));\n  loadTab();\n}\n\nfunction dates(){ return { start_date: $('d1').value, end_date: $('d2').value }; }\nfunction refresh(){ showTab(TAB); }\n\nconst loaded = {};\nfunction loadTab(){ loaded[TAB] = false; ({overview:loadOverview,campaigns:()=>loadCampaigns(0),searchterms:()=>loadTerms(0),targeting:()=>loadTargeting(0),products:()=>loadProducts(0),placements:()=>loadPlacements(0)})[TAB](); }\n\nasync function guard(fn){\n  $('loading').classList.remove('hidden'); $('appErr').textContent = '';\n  try { await fn(); } catch(e){ $('appErr').textContent = e.message; }\n  $('loading').classList.add('hidden');\n}\n\n// ---------- overview ----------\nasync function loadOverview(){ await guard(async () => {\n  const r = await api('get_campaign_performance', { amazon_account_id: ACCT.id, ...dates(), page_size: 500 });\n  const s = r.summary || {};\n  const spend = s.cost, sales = s.attributedSales14d;\n  const tiles = [\n    ['Spend', fmtM(spend)], ['Sales', fmtM(sales)],\n    ['ACOS', spend && sales ? fmtP(spend/sales*100) : fmtP(s.acos)],\n    ['ROAS', sales && spend ? (sales/spend).toFixed(2) : (s.roas ?? '\u2014')],\n    ['Impressions', fmtN(s.impressions)], ['Clicks', fmtN(s.clicks)],\n    ['Orders', fmtN(s.purchases)],\n    ['CPC', fmtM2(s.cpc ?? (s.clicks ? spend/s.clicks : null))]\n  ];\n  $('ovTiles').innerHTML = tiles.map(([l,v]) => `<div class=\"tile\"><div class=\"lbl\">${l}</div><div class=\"val\">${v}</div></div>`).join('');\n  const top = (r.data || []).slice().sort((a,b) => (b.cost||0)-(a.cost||0)).slice(0,10);\n  drawBars('ovChart', top);\n}); }\n\nfunction drawBars(elId, rows){\n  const el = $(elId);\n  if (!rows.length) { el.innerHTML = '<p class=\"muted\">No data for this range.</p>'; return; }\n  const max = Math.max(...rows.flatMap(r => [r.cost||0, r.attributedSales14d||0]), 1);\n  const W = 900, LBL = 260, BARW = W-LBL-70, RH = 44, H = rows.length*RH+10;\n  let svg = `<svg viewBox=\"0 0 ${W} ${H}\" style=\"width:100%;height:auto\" xmlns=\"http://www.w3.org/2000/svg\">`;\n  rows.forEach((r,i) => {\n    const y = i*RH+8;\n    const w1 = Math.max((r.cost||0)/max*BARW, 1), w2 = Math.max((r.attributedSales14d||0)/max*BARW, 1);\n    const nm = (r.campaignName||'').length > 34 ? (r.campaignName||'').slice(0,33)+'\u2026' : (r.campaignName||'');\n    svg += `<text x=\"${LBL-8}\" y=\"${y+16}\" text-anchor=\"end\" font-size=\"12\" fill=\"var(--ink-2)\">${esc(nm)}</text>`;\n    svg += `<rect class=\"hv\" data-tip=\"${esc(r.campaignName)}&#10;Spend ${esc(fmtM2(r.cost))} \u00b7 ACOS ${esc(fmtP(r.acos))}\" x=\"${LBL}\" y=\"${y}\" width=\"${w1}\" height=\"11\" rx=\"2\" fill=\"var(--s1)\"/>`;\n    svg += `<rect class=\"hv\" data-tip=\"${esc(r.campaignName)}&#10;Sales ${esc(fmtM2(r.attributedSales14d))} \u00b7 ROAS ${r.roas ?? '\u2014'}\" x=\"${LBL}\" y=\"${y+13}\" width=\"${w2}\" height=\"11\" rx=\"2\" fill=\"var(--s2)\"/>`;\n    svg += `<text x=\"${LBL+Math.max(w1,w2)+6}\" y=\"${y+18}\" font-size=\"11\" fill=\"var(--muted)\">${esc(fmtP(r.acos))} ACOS</text>`;\n  });\n  svg += '</svg>';\n  el.innerHTML = svg;\n  el.querySelectorAll('.hv').forEach(n => {\n    n.addEventListener('mousemove', e => {\n      const t = $('tooltip'); t.style.display = 'block';\n      t.style.left = (e.clientX+12)+'px'; t.style.top = (e.clientY+12)+'px';\n      t.innerText = n.dataset.tip;\n    });\n    n.addEventListener('mouseleave', () => $('tooltip').style.display = 'none');\n  });\n}\n\n// ---------- generic table ----------\nfunction renderTable(tblId, pgnId, rows, cols, pagination, loader){\n  const tbl = $(tblId);\n  if (!rows.length){ tbl.innerHTML = '<tr><td class=\"muted\">No data.</td></tr>'; $(pgnId).innerHTML=''; return; }\n  tbl.innerHTML = '<tr>' + cols.map(c => `<th class=\"${c.num?'num':''}\">${c.h}</th>`).join('') + '</tr>' +\n    rows.map(r => '<tr>' + cols.map(c => `<td class=\"${c.num?'num':''}\">${c.f(r)}</td>`).join('') + '</tr>').join('');\n  const p = pagination || {};\n  $(pgnId).innerHTML = p.totalPages > 1\n    ? `<button class=\"chip\" ${p.page<=0?'disabled':''} onclick=\"${loader}(${p.page-1})\">\u2039 Prev</button>\n       Page ${p.page+1} / ${p.totalPages} (${p.total} rows)\n       <button class=\"chip\" ${!p.hasMore?'disabled':''} onclick=\"${loader}(${p.page+1})\">Next \u203a</button>`\n    : (p.total ? `${p.total} rows` : '');\n}\nconst mcols = [\n  {h:'Spend',num:1,f:r=>fmtM2(r.cost)}, {h:'Sales',num:1,f:r=>fmtM2(r.attributedSales14d)},\n  {h:'ACOS',num:1,f:r=>fmtP(r.acos)}, {h:'ROAS',num:1,f:r=>r.roas!=null?(+r.roas).toFixed(2):'\u2014'},\n  {h:'Impr.',num:1,f:r=>fmtN(r.impressions)}, {h:'Clicks',num:1,f:r=>fmtN(r.clicks)},\n  {h:'CTR',num:1,f:r=>fmtP(r.ctr)}, {h:'CPC',num:1,f:r=>fmtM2(r.cpc)},\n  {h:'Orders',num:1,f:r=>fmtN(r.purchases)}, {h:'CVR',num:1,f:r=>fmtP(r.cvr)}\n];\n\nasync function loadCampaigns(page){ await guard(async () => {\n  const r = await api('get_campaign_performance', { amazon_account_id: ACCT.id, ...dates(), status: $('cmpStatus').value, page, page_size: 50, sort_field:'cost', sort_direction:'desc' });\n  renderTable('cmpTbl','cmpPgn', r.data||[], [{h:'Campaign',f:r=>esc(r.campaignName)}, ...mcols], r.pagination, 'loadCampaigns');\n}); }\n\nasync function loadTerms(page){ await guard(async () => {\n  const args = { amazon_account_id: ACCT.id, ...dates(), page, page_size: 50, sort_field:'cost', sort_direction:'desc' };\n  const q = $('stSearch').value.trim(); if (q) args.search_term = q;\n  const r = await api('get_search_term_performance', args);\n  renderTable('stTbl','stPgn', r.data||[], [{h:'Search term',f:r=>esc(r.searchTerm)}, ...mcols], r.pagination, 'loadTerms');\n}); }\n\nasync function loadTargeting(page){ await guard(async () => {\n  const r = await api('get_targeting_performance', { amazon_account_id: ACCT.id, ...dates(), page, page_size: 50, sort_field:'cost', sort_direction:'desc' });\n  renderTable('tgTbl','tgPgn', r.data||[], [{h:'Target',f:r=>esc(r.targetingValue)}, {h:'Campaign',f:r=>esc(r.campaignName)}, ...mcols], r.pagination, 'loadTargeting');\n}); }\n\nasync function loadProducts(page){ await guard(async () => {\n  const r = await api('get_advertised_product_performance', { amazon_account_id: ACCT.id, ...dates(), page, page_size: 50, sort_field:'cost', sort_direction:'desc' });\n  renderTable('pdTbl','pdPgn', r.data||[], [{h:'ASIN',f:r=>esc(r.adAsin||r.asin)}, {h:'Product',f:r=>esc((r.adProductName||r.itemName||'').slice(0,50))}, ...mcols], r.pagination, 'loadProducts');\n}); }\n\nasync function loadPlacements(page){ await guard(async () => {\n  const r = await api('get_placement_performance', { amazon_account_id: ACCT.id, ...dates(), page, page_size: 50, sort_field:'cost', sort_direction:'desc' });\n  renderTable('plTbl','plPgn', r.data||[], [{h:'Placement',f:r=>esc(r.placementClassification||r.placement)}, {h:'Campaign',f:r=>esc(r.campaignName)}, ...mcols], r.pagination, 'loadPlacements');\n}); }\n\n// auto-login\nif (KEY) { $('keyInput').value = KEY; connect(); }\n</script>\n</body>\n</html>\n"}]