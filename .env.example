# API Keys
SELLERMATE_API_KEY_A=your_sellermate_api_key_a
SELLERMATE_API_KEY_B=your_sellermate_api_key_b
GEMINI_API_KEY=your_gemini_api_key

# Email Configuration — Resend (https://resend.com); see EMAIL_FROM note in send-email.ts
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=reports@yourdomain.com

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Base URL for this project's Supabase Edge Functions (no trailing slash), e.g.
# https://abcdefghijklmnop.functions.supabase.co
SUPABASE_EDGE_URL=your_supabase_edge_functions_url

# ── Security (see docs/security.md) — every one of these FAILS CLOSED when unset ──
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically once this is set; the
# external 30-min scheduler for /api/cron/campaign-monitor must send the same header.
CRON_SECRET=generate_a_long_random_value
# Signs every server-to-server call (internalFetch) and the calls to the Supabase Edge Functions.
# Set the SAME value as a Supabase function secret and in Vault (see docs/security.md).
INTERNAL_API_SECRET=generate_a_long_random_value
# Dashboard sign-in password (username Barm or Lkn only picks the account slot).
DASHBOARD_PASSWORD=choose_a_strong_password
# Trusted origin for internal calls. Optional on Vercel (falls back to https://$VERCEL_URL);
# required when self-hosting behind a domain. Never derived from the request's Host header.
APP_INTERNAL_ORIGIN=https://your-dashboard-domain.example
